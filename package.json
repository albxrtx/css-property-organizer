{
  "name": "css-property-organizer",
  "displayName": "CSS Property Organizer",
  "description": "Automatically organizes the properties in your CSS files into groups based on their purpose, making your rules cleaner, more organized, and easier to read.",
  "version": "0.0.1",
  "publisher": "albxrtx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/albxrtx/css-property-organizer.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.organize-by-groups",
        "title": "%command.organizeByGroups%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -watch -p ./",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/vscode": "~1.105.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.13.0",
    "mocha": "^12.0.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "postcss": "^8.5.29"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
